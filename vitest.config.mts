import { fileURLToPath } from 'node:url'
import { defineConfig } from 'vitest/config'

export default defineConfig({
  resolve: {
    // Тот же псевдоним, что в tsconfig.json. Без него тесты не смогут
    // ввозить модули так же, как это делают компоненты, и пути в тестах
    // разойдутся с путями в коде.
    alias: { '@': fileURLToPath(new URL('./', import.meta.url)) },
  },
  test: {
    // Окружение Node, а не браузера: тестируются только чистые функции.
    // Браузерное окружение здесь стоило бы секунд запуска и ничего не дало.
    environment: 'node',
    // Тесты живут ТОЛЬКО в tests/, рядом с кодом их нет и не должно быть:
    // здесь проверяются чистые функции из lib/, и держать их проверки в
    // одном месте — единственный способ увидеть, что покрыто, а что нет.
    // Положишь тест рядом с компонентом — этот шаблон его не подберёт, и
    // он будет молча не запускаться.
    include: ['tests/**/*.test.ts'],
  },
})
